DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

AUTH_SERVICE_URL=http://localhost:3001

PORT=3000
NODE_ENV=development

LOG_SERVICE_URL=http://log-service:3002

# MinIO interno; fotos dos anúncios são servidas pela API após validação de acesso.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=perfil-fotos

# Stripe exclusivamente de teste (sk_test_...). Nunca commite valores: preencha só no .env local
# e nas variáveis da stack no Portainer.
# Chave secreta de teste da conta Stripe.
STRIPE_SECRET_KEY=
# ID do preço recorrente mensal do plano Pro (R$ 39,90/mês, BRL), price_...
STRIPE_PRICE_ID=
# Opcional: ID do preço Free (R$ 0/mês, BRL), para o cliente trocar Pro -> Free pelo portal.
STRIPE_PRICE_FREE_ID=
# Segredo do endpoint de webhook das assinaturas (/api/stripe/webhook), whsec_...
STRIPE_WEBHOOK_SECRET=
# Opcional: configuração do portal do cliente (bpc_...). Vazio usa a configuração padrão do modo de teste.
STRIPE_PORTAL_CONFIGURATION_ID=
# Segredo do endpoint de webhook do pagamento de locação (/api/locacao/stripe/webhook), whsec_...
STRIPE_LOCACAO_WEBHOOK_SECRET=
# Origem pública do app, usada nos retornos do checkout e do portal (ex.: https://seu-subdominio)
APP_BASE_URL=
